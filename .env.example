# mabubot-guard の環境変数の見本。コピーして .env を作り、値を入れること。
# 実トークンをリポジトリに含めないこと。

# Discord のトークン（必須。この Bot 専用のアプリケーションを使うこと。
# 他の mabubot-* や p1228 のものは使い回さない）
DISCORD_TOKEN=
# Discord アプリケーション ID（必須。コマンド同期・削除に使う）
DISCORD_APPLICATION_ID=
# SQLite データの保存先（任意。既定は ./data で、data/mabubot-guard.db に保存される）
DATA_DIR=./data
# プレゼンスのカスタム文言（任意。未指定なら既定文言。
# /watching set で保存した文言があればそちらが優先される）
WATCHING_TEXT=まぶさばを見守り中
# 起動時 DB バックアップの保持世代数（任意。既定は 10）
# DB_BACKUP_RETENTION=10
